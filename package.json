{
  "name": "community-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-powered agent that manages the NZ Claude community Discord server and a WhatsApp number, with persistent memory for learning.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "undici": "^6.27.0",
    "brace-expansion": "^5.0.8",
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/base/storage/schema/*.sql dist/base/storage/schema/ && cp CHANGELOG.md dist/CHANGELOG.md && cp -r src/module/agent/skills dist/module/agent/skills && node scripts/check-dist-schema.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "tsx --experimental-test-module-mocks --test tests/*.test.ts",
    "test:security": "LOG_LEVEL=${LOG_LEVEL:-silent} node scripts/check-security-test-count.mjs",
    "test:security:fix": "node scripts/check-security-test-count.mjs --write",
    "imports:check": "node scripts/check-import-direction.mjs",
    "context:check": "node scripts/check-context-pack.mjs --src src --src src/base --src src/module",
    "context:fix": "node scripts/check-context-pack.mjs --write --src src --src src/base --src src/module",
    "changelog:check": "gh pr list --state merged --limit 150 --json number,title,mergedAt,body | node scripts/check-changelog-coverage.mjs",
    "migrate": "tsx src/base/storage/migrate.ts",
    "migrate:ci": "CLAUDE_CODE_OAUTH_TOKEN=ci-dummy-token npm run migrate",
    "migrate:prod": "node dist/base/storage/migrate.js",
    "export:context": "tsx src/module/context/export.ts",
    "whatsapp:link": "tsx src/module/platforms/whatsapp/link.ts",
    "eval:answers": "tsx scripts/eval-answers.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@hapi/boom": "^10.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@whiskeysockets/baileys": "6.7.24",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "undici": "^6.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
